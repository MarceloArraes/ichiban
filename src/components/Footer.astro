---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.jpeg';
import { site, navLinks } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="#top" class="brand">
        <Image src={logo} alt={`${site.name} logo`} class="brand__logo" width={264} height={200} />
        <span>
          <span class="brand__name">{site.name}</span><br />
          <span class="brand__tagline">{site.tagline}</span>
        </span>
      </a>
      <p>
        Hebel cladding installation for homes and commercial builds across {site.serviceArea}.
        From prep to finish, done to the number one standard.
      </p>
    </div>

    <div class="footer__col">
      <h4>Explore</h4>
      <ul class="footer__links">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h4>Contact</h4>
      <ul class="footer__links">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
        <li>{site.serviceArea}</li>
        <li>{site.postcode}</li>
      </ul>
    </div>
  </div>

  <div class="footer__legal">
    <div class="container">
      <span>
        &copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.
      </span>
      <span>
        ABN {site.abn} · ACN {site.acn} · GST registered
      </span>
    </div>
  </div>
</footer>
