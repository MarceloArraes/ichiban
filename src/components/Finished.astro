---
import { Image } from 'astro:assets';
import front from '../assets/images/finished/front.jpeg';
import frontSecondStorey from '../assets/images/finished/front-second-storey.jpeg';
import lateral from '../assets/images/finished/lateral.jpeg';
import build1 from '../assets/images/finished/build-1.jpeg';
import build2 from '../assets/images/finished/build-2.jpeg';

const featured = {
  img: front,
  label: 'Front façade — completed',
  alt: 'Completed two-storey home with a smooth white Hebel cladding façade',
};

const projects = [
  {
    img: frontSecondStorey,
    label: 'Second-storey elevation',
    alt: 'Completed upper storey with Hebel cladding and contrasting dark feature panels',
  },
  {
    img: lateral,
    label: 'Side entry',
    alt: 'Side entry and rear walkway finished in white Hebel cladding',
  },
  {
    img: build1,
    label: 'Finished build',
    alt: 'Completed two-storey home with Hebel cladding, timber battens and metal roofing',
  },
  {
    img: build2,
    label: 'Completed façade',
    alt: 'Street view of a completed two-storey home with Hebel cladding and timber battens',
  },
];

const sized = (img: typeof front, width: number) => ({
  width,
  height: Math.round((width * img.height) / img.width),
});
---

<section class="section" id="finished">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Finished projects</span>
      <h2>The result speaks for itself</h2>
      <p class="lead">
        Straight lines, crisp corners and a finish that&rsquo;s ready for paint — that&rsquo;s the
        Ichiban standard on every wall we hand over.
      </p>
    </div>

    <div class="finished__grid">
      <figure class="finished__card finished__card--featured">
        <Image
          src={featured.img}
          alt={featured.alt}
          {...sized(featured.img, 1600)}
          sizes="100vw"
          quality={82}
        />
        <figcaption class="finished__label">{featured.label}</figcaption>
      </figure>

      {
        projects.map((project) => (
          <figure class="finished__card">
            <Image
              src={project.img}
              alt={project.alt}
              {...sized(project.img, 1280)}
              sizes="(min-width: 760px) 50vw, 100vw"
              loading="lazy"
              quality={82}
            />
            <figcaption class="finished__label">{project.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
