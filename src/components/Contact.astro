---
import { site } from '../data/site';
---

<section class="section" id="contact">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Contact</span>
      <h2>Get a free quote</h2>
      <p class="lead">
        Tell us about your project and we&rsquo;ll come back to you with a no-obligation
        quote. We work across {site.serviceArea}.
      </p>
    </div>

    <div class="contact__grid">
      <div>
        <ul class="contact__list">
          <li class="contact__item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span><a href={site.phoneHref}>{site.phone}</a></span>
          </li>
          <li class="contact__item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span><a href={site.emailHref}>{site.email}</a></span>
          </li>
          <li class="contact__item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{site.serviceArea} — {site.postcode}</span>
          </li>
          <li class="contact__item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Mon–Sat, 7am–5pm</span>
          </li>
        </ul>
      </div>

      <form class="contact-form" id="quoteForm">
        <label>
          Name
          <input type="text" name="name" placeholder="Your name" required />
        </label>
        <label>
          Phone
          <input type="tel" name="phone" placeholder="Your phone number" required />
        </label>
        <label>
          Email
          <input type="email" name="email" placeholder="you@example.com" />
        </label>
        <label>
          Project details
          <textarea name="message" placeholder="Tell us about your project — location, size, timeline." required></textarea>
        </label>
        <button class="btn btn--primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quoteForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = `Quote request — ${data.get('name')}`;
    const body = [
      `Name: ${data.get('name')}`,
      `Phone: ${data.get('phone')}`,
      `Email: ${data.get('email') || 'Not provided'}`,
      '',
      'Project details:',
      data.get('message'),
    ].join('\n');

    window.location.href = `mailto:${'info@ichibancladding.com.au'}?subject=${encodeURIComponent(
      subject,
    )}&body=${encodeURIComponent(body)}`;
  });
</script>
